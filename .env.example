# ── Flights: Travelpayouts / Aviasales Data API ─────────────────────────────
# Бесплатный токен: travelpayouts.com → регистрация → программа Aviasales → API-токен.
TRAVELPAYOUTS_TOKEN=
# Необязательно: ваш partner marker, добавляется в ссылки на билеты.
TRAVELPAYOUTS_MARKER=
# Рынок кэша цен Aviasales (ru = цены для покупателей из России).
AVIASALES_MARKET=ru

# ── Hotels ──────────────────────────────────────────────────────────────────
# xotelo  — бесплатно, без ключа: цены TripAdvisor (Booking.com, Trip.com, Agoda, Expedia…) на даты.
# tripcom — официальный Trip.com API (нужен партнёрский доступ, клиент пока не подключён).
HOTEL_PROVIDER=xotelo
# Необязательно: ключ RapidAPI для поиска города в Xotelo по названию (если города нет в справочнике/Wikidata).
RAPIDAPI_KEY=
# Для скольких направлений (с самыми дешёвыми перелётами) проверять цены отелей.
HOTEL_MAX_DESTINATIONS=8
# Сколько вариантов дат на направление проверять.
HOTEL_STAYS_PER_DESTINATION=2
# Сколько самых дешёвых отелей города запрашивать на конкретные даты.
HOTEL_CANDIDATES=3
TRIPCOM_API_KEY=
TRIPCOM_API_SECRET=

# ── Поиск ───────────────────────────────────────────────────────────────────
# Валюта пользователя по умолчанию.
DEFAULT_CURRENCY=RUB
# "Anytime" = ближайшие N месяцев.
DEFAULT_SEARCH_MONTHS=3
# Доступная длительность поездки, ночей: границы для формы и запроса словами, и диапазон "Flexible".
FLEXIBLE_NIGHTS_MIN=2
FLEXIBLE_NIGHTS_MAX=30
# Сколько городов вылета проверять, когда FROM = страна / регион / Anywhere
# (города ранжируются по числу реальных маршрутов из аэропортов).
MAX_ORIGIN_CITIES=25
# Сколько направлений разбирать глубоко (календари туда/обратно, отели).
MAX_CANDIDATE_DESTINATIONS=20
# Сколько самых дешёвых городов вылета проверять для каждого направления.
MAX_ORIGINS_PER_DESTINATION=2
# Сколько лучших результатов перепроверять перед показом.
REVALIDATE_TOP=5
# Свежесть цен: брать только цены, которые пользователи Aviasales видели не раньше N дней назад.
PRICE_MAX_AGE_DAYS=2
# ── Мониторинг цен (база cheaptrip/data/trips.db) ─────────────────────────────
# Как часто заново сверять цену и наличие каждого отслеживаемого билета, секунд.
WATCH_INTERVAL_SECONDS=10
# Сколько лучших направлений последнего поиска отслеживать автоматически (плюс закреплённые 📌).
WATCH_AUTO_TOP=20
# Максимум запросов к Aviasales за один цикл: 25 за 10 с = 150 в минуту из общего лимита 600.
WATCH_MAX_REQUESTS=25

# ── Уведомления в Telegram ────────────────────────────────────────────────────
# Токен бота от @BotFather. Пусто — кнопки уведомлений на сайте не показываются.
TELEGRAM_BOT_TOKEN=
# Сообщать об изменении, только если новое состояние продержалось столько секунд (защита от «мигания» цен).
TELEGRAM_CONFIRM_SECONDS=60
# Не чаще одного сообщения по одному билету раз в N минут (промежуточные скачки сворачиваются).
TELEGRAM_MIN_INTERVAL_MINUTES=5
# Сколько билетов может отслеживать один браузер.
TELEGRAM_MAX_TICKETS=40

# Параллельных запросов к API.
HTTP_CONCURRENCY=6
# Кэш ответов API, минут.
API_CACHE_MINUTES=60

# Порт веб-интерфейса.
PORT=8770

# ── Бесплатный хостинг (Render): заполняет deploy/render_setup.py в настройках Render ──
# Заходить на свой адрес раз в N минут, чтобы хостинг не усыплял сайт (0 — выключено).
KEEP_AWAKE_MINUTES=0
# Секретный GitHub Gist для отслеживаемых билетов и привязок Telegram (диск Render стирается при перезапуске).
BACKUP_GIST_ID=
BACKUP_GITHUB_TOKEN=
BACKUP_EVERY_MINUTES=5

# ── Ключи для публикации (читает только deploy/render_setup.py; на сайт не попадают) ──
DEPLOY_GITHUB_TOKEN=
RENDER_API_KEY=
